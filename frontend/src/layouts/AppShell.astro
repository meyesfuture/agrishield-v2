---
import '../styles/tokens.css';
import '../styles/dashboard.css';

interface Props {
  title?: string;
  description?: string;
  activeNav?: 'home' | 'dashboard';
}

const {
  title = "Punjab GrainWatch — Hoarding Risk Exploration",
  description = "Focused agricultural intelligence dashboard for exploring potential grain-hoarding risk locations across Punjab.",
  activeNav = "home"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
</head>
<body>
  <!-- Accessible Skip Link -->
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <div class="app-layout">
    <!-- Top Navigation Header -->
    <header class="top-nav" role="banner">
      <div class="nav-container">
        <div class="brand-section">
          <a href="/" class="brand-logo" aria-label="Punjab GrainWatch Home">
            <span class="logo-icon" aria-hidden="true">🌾</span>
            <div class="brand-text">
              <span class="brand-title">PUNJAB GRAINWATCH</span>
              <span class="brand-subtitle">Hoarding Risk Screening</span>
            </div>
          </a>
        </div>

        <!-- Minimal Primary Navigation (Home + Dashboard only) -->
        <nav class="nav-links" role="navigation" aria-label="Main Navigation">
          <a href="/" class={activeNav === 'home' ? 'nav-item active' : 'nav-item'}>
            Home
          </a>
          <a href="/dashboard" class={activeNav === 'dashboard' ? 'nav-item active' : 'nav-item'}>
            Dashboard
          </a>
        </nav>

        <div class="header-actions">
          <a href="/dashboard" class="btn-nav-cta">
            Open Dashboard →
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content Area -->
    <main id="main-content" class="main-content" role="main">
      <div class="content-container">
        <slot />
      </div>
    </main>

    <!-- App Footer -->
    <footer class="app-footer" role="contentinfo">
      <div class="footer-container">
        <div class="footer-left">
          <span class="footer-brand">Punjab GrainWatch v1.0.0</span>
          <span class="footer-divider">•</span>
          <span>Potential Grain-Hoarding Risk Exploration</span>
          <span class="footer-divider">•</span>
          <span>Survey of India / NWIC Boundaries (23 Districts)</span>
        </div>
        <div class="footer-right">
          <span class="footer-governance">AGENTS.md Rule 6 Governed</span>
        </div>
      </div>
    </footer>
  </div>
</body>
</html>
