---
import AppShell from '../layouts/AppShell.astro';
import MetricCard from '../components/MetricCard.astro';
import GuardrailBanner from '../components/GuardrailBanner.astro';
import Hero3DScene from '../components/Hero3DScene';
---

<AppShell title="Punjab GrainWatch — Executive Overview" activeNav="overview">
  <div class="overview-page">
    <!-- Hero Header with 3D Agricultural Silo & Field Visualizer -->
    <section class="hero-section" aria-labelledby="hero-title">
      <div class="hero-grid">
        <div class="hero-content">
          <div class="hero-badge">PHASE 5 REFINED AGRICULTURAL INTELLIGENCE</div>
          <h1 id="hero-title" class="hero-title">
            Auditable Agricultural Intelligence for <span class="text-wheat">Punjab Supply Chains</span>
          </h1>
          <p class="hero-lead">
            An honest, reproducible evidence platform built on verifiable physical datasets. Enforces strict provenance,
            exact checksums, and zero simulated metrics.
          </p>

          <div class="hero-actions">
            <a href="/production-yield" class="btn btn-primary">
              <span>Production & Yields</span>
              <span aria-hidden="true">→</span>
            </a>
            <a href="/district-map" class="btn btn-secondary">
              <span>District Map</span>
            </a>
            <a href="/datasets" class="btn btn-secondary">
              <span>Dataset Explorer</span>
            </a>
            <a href="/status" class="btn btn-secondary">
              <span>Readiness & Integrity</span>
            </a>
          </div>
        </div>

        <div class="hero-visual">
          <Hero3DScene client:load />
        </div>
      </div>
    </section>

    <!-- Guardrail Banner -->
    <GuardrailBanner />

    <!-- Interactive Navigation Hub (9 Core Views) -->
    <section class="views-hub-section" aria-labelledby="hub-heading">
      <h2 id="hub-heading" class="section-heading">Operational Intelligence Modules</h2>
      <div class="views-hub-grid">
        <a href="/production-yield" class="hub-card">
          <div class="hub-header">
            <span class="hub-icon">🌾</span>
            <span class="hub-badge status-observed">OBSERVED</span>
          </div>
          <h3 class="hub-title">Production & Yield Explorer</h3>
          <p class="hub-desc">2,530 historical OGD yield records (1968–2022) and 230 DES APY district production rows (2018–2023) across 23 districts.</p>
          <div class="hub-footer">Explore Trends & Data Table →</div>
        </a>

        <a href="/market-watch" class="hub-card">
          <div class="hub-header">
            <span class="hub-icon">📈</span>
            <span class="hub-badge status-blocked">BLOCKED ARRIVALS</span>
          </div>
          <h3 class="hub-title">Market Watch & Modal Prices</h3>
          <p class="hub-desc">AGMARKNET 2.0 daily modal prices for paddy across Punjab mandis. Highlights 100% null arrival quantity limitation.</p>
          <div class="hub-footer">View Daily Modal Prices →</div>
        </a>

        <a href="/weather" class="hub-card">
          <div class="hub-header">
            <span class="hub-icon">⛅</span>
            <span class="hub-badge status-observed">OBSERVED</span>
          </div>
          <h3 class="hub-title">Agro-Climatic Weather Context</h3>
          <p class="hub-desc">NASA POWER daily temperature, precipitation, and relative humidity across 5 agro-climatic stations (3,655 rows, 0 nulls).</p>
          <div class="hub-footer">Inspect Weather Stations →</div>
        </a>

        <a href="/procurement-stocks" class="hub-card">
          <div class="hub-header">
            <span class="hub-icon">🏛️</span>
            <span class="hub-badge status-derived">CONTEXT ONLY</span>
          </div>
          <h3 class="hub-title">Procurement & Buffer Stocks</h3>
          <p class="hub-desc">CFPP RMS 2025-26 wheat procurement snapshot alongside DFPD national monthly central pool buffer stocks (2020–2026).</p>
          <div class="hub-footer">Inspect Buffer Stocks →</div>
        </a>

        <a href="/district-map" class="hub-card">
          <div class="hub-header">
            <span class="hub-icon">🗺️</span>
            <span class="hub-badge status-observed">23 DISTRICTS</span>
          </div>
          <h3 class="hub-title">District Boundary Map</h3>
          <p class="hub-desc">Interactive SVG boundary choropleth for 23 Punjab districts with Malerkotla 2022 vintage carveout and 1:1 crosswalk.</p>
          <div class="hub-footer">Open Interactive Map →</div>
        </a>

        <a href="/status" class="hub-card">
          <div class="hub-header">
            <span class="hub-icon">🛡️</span>
            <span class="hub-badge status-blocked">NO-GO VERDICT</span>
          </div>
          <h3 class="hub-title">Readiness & Integrity Matrix</h3>
          <p class="hub-desc">8-element supply chain coverage matrix, 6 mathematical integrity assertions, and live system health telemetry.</p>
          <div class="hub-footer">Review Readiness Audit →</div>
        </a>

        <a href="/datasets" class="hub-card">
          <div class="hub-header">
            <span class="hub-icon">📦</span>
            <span class="hub-badge status-derived">20 DATASETS</span>
          </div>
          <h3 class="hub-title">Dataset Catalog & Downloads</h3>
          <p class="hub-desc">Searchable data inventory with schema inspector, SHA-256 validation digests, and client-side JSON downloads with caveats.</p>
          <div class="hub-footer">Inspect & Export Datasets →</div>
        </a>

        <a href="/methodology" class="hub-card">
          <div class="hub-header">
            <span class="hub-icon">📜</span>
            <span class="hub-badge status-observed">GOVERNANCE</span>
          </div>
          <h3 class="hub-title">Methodology & Decision Log</h3>
          <p class="hub-desc">Core non-negotiable evidentiary rules: zero hoarding conclusions, absence vs zero semantics, and calibrated schemas.</p>
          <div class="hub-footer">Read Scientific Governance →</div>
        </a>
      </div>
    </section>

    <!-- Executive KPI Grid -->
    <section class="kpi-section" aria-labelledby="kpi-heading">
      <h2 id="kpi-heading" class="section-heading">Verified Evidence Inventory (Phase 1 Baseline)</h2>

      <div class="kpi-grid">
        <MetricCard
          title="Cryptographic Integrity"
          value="49 / 49"
          subtitle="All raw acquisition files match starter manifest SHA-256 digests."
          badgeText="100% MATCH"
          badgeType="observed"
        />

        <MetricCard
          title="Cataloged Datasets"
          value="20"
          subtitle="Physical data assets across 8 supply chain dimensions."
          badgeText="AUDITED"
          badgeType="derived"
        />

        <MetricCard
          title="Mandi Produce Arrivals"
          value="3,892"
          subtitle="Oct 2026 arrivals (62 APMC crops; 0 foodgrain records)."
          badgeText="0 GRAIN ROWS"
          badgeType="blocked"
        />

        <MetricCard
          title="Paddy Price Quotes"
          value="53"
          subtitle="Oct 2026 daily modal prices (arrival quantities are 100% null)."
          badgeText="NULL VOLUMES"
          badgeType="blocked"
        />

        <MetricCard
          title="Agro-Climatic Weather"
          value="3,655"
          subtitle="5 stations across 731 days (2024–2025) with zero missing cells."
          badgeText="0% NULLS"
          badgeType="observed"
        />

        <MetricCard
          title="District Boundaries"
          value="23"
          subtitle="Punjab administrative polygons in EPSG:4326 with 1:1 crosswalk."
          badgeText="23 DISTRICTS"
          badgeType="observed"
        />
      </div>
    </section>
  </div>
</AppShell>

<style>
  .overview-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .hero-section {
    padding: var(--space-8) 0 var(--space-4) 0;
    max-width: 900px;
  }

  .hero-badge {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-wheat-500);
    letter-spacing: 0.08em;
    padding: 0.2rem 0.6rem;
    background: rgba(232, 200, 114, 0.1);
    border: 1px solid rgba(232, 200, 114, 0.3);
    border-radius: var(--radius-full);
    margin-bottom: var(--space-3);
  }

  .hero-title {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--text-primary);
    margin-bottom: var(--space-4);
  }

  .text-wheat {
    color: var(--color-wheat-500);
  }

  .hero-lead {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-6);
    max-width: 760px;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.65rem 1.4rem;
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transition: all var(--transition-fast);
    cursor: pointer;
  }

  .btn-primary {
    background: var(--color-wheat-500);
    color: var(--color-slate-950);
    border: 1px solid var(--color-wheat-600);
    box-shadow: 0 2px 8px rgba(232, 200, 114, 0.25);
  }

  .btn-primary:hover {
    background: var(--color-wheat-400);
    color: var(--color-slate-950);
    text-decoration: none;
    transform: translateY(-1px);
  }

  .btn-secondary {
    background: var(--bg-surface-elevated);
    color: var(--text-primary);
    border: 1px solid var(--border-medium);
  }

  .btn-secondary:hover {
    background: var(--bg-surface-hover);
    color: var(--text-primary);
    text-decoration: none;
    border-color: var(--border-strong);
  }

  .section-heading {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .views-hub-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-4);
  }

  .hub-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    text-decoration: none;
    transition: all var(--transition-normal);
  }

  .hub-card:hover {
    border-color: var(--color-wheat-500);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
    text-decoration: none;
  }

  .hub-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-1);
  }

  .hub-icon {
    font-size: 1.5rem;
  }

  .hub-badge {
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-full);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .status-observed {
    background: rgba(16, 185, 129, 0.15);
    color: var(--color-emerald-400);
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .status-derived {
    background: rgba(59, 130, 246, 0.15);
    color: #60a5fa;
    border: 1px solid rgba(59, 130, 246, 0.3);
  }

  .status-blocked {
    background: rgba(239, 68, 68, 0.15);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.3);
  }

  .hub-title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--text-primary);
  }

  .hub-desc {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: 1.5;
    flex: 1;
  }

  .hub-footer {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-wheat-500);
    margin-top: var(--space-2);
  }

  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-4);
  }
</style>
