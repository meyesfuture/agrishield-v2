---
import AppShell from '../layouts/AppShell.astro';
import { SystemHealthMonitor } from '../components/SystemHealthMonitor';
import QualityReadinessView from '../components/QualityReadinessView';
---

<AppShell title="Audit, Quality & System Readiness — Punjab GrainWatch" activeNav="status">
  <div class="status-page">
    <SystemHealthMonitor client:load />
    <QualityReadinessView client:load />
  </div>
</AppShell>

<style>
  .status-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
</style>
