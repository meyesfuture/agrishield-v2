---
import AppShell from '../layouts/AppShell.astro';
import { SystemHealthMonitor } from '../components/SystemHealthMonitor';
---

<AppShell title="Punjab GrainWatch — Pipeline Audit & System Status" activeNav="status">
  <div class="status-page">
    <header class="page-header">
      <div class="header-breadcrumbs">
        <a href="/">Overview</a> / <span>Pipeline Audit & System Status</span>
      </div>
      <h1 class="page-title">Pipeline Audit & Evidence Boundaries</h1>
      <p class="page-subtitle">
        Real-time telemetry and evidence compliance matrix. All data constraints are enforced via
        automated pytest suites and cryptographic SHA-256 manifest verification.
      </p>
    </header>

    <SystemHealthMonitor client:load />
  </div>
</AppShell>

<style>
  .status-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .page-header {
    margin-bottom: var(--space-2);
  }

  .header-breadcrumbs {
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-bottom: var(--space-2);
  }

  .header-breadcrumbs a {
    color: var(--text-secondary);
  }

  .page-title {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .page-subtitle {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    max-width: 800px;
    line-height: 1.5;
  }
</style>
