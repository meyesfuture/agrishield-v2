---
import '../styles/tokens.css';
import '../styles/dashboard.css';

interface Props {
  title?: string;
  description?: string;
  activeNav?: 'overview' | 'datasets' | 'production' | 'markets' | 'weather' | 'procurement' | 'map' | 'status' | 'methodology';
}

const {
  title = "Punjab GrainWatch — Factual Agricultural Intelligence",
  description = "Evidence-based, auditable monitoring platform for Punjab agricultural supply chains.",
  activeNav = "overview"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
</head>
<body>
  <!-- Accessible Skip Link -->
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <div class="app-layout">
    <!-- Top Navigation Header -->
    <header class="top-nav" role="banner">
      <div class="nav-container">
        <div class="brand-section">
          <a href="/" class="brand-logo" aria-label="Punjab GrainWatch Home">
            <span class="logo-icon" aria-hidden="true">🌾</span>
            <div class="brand-text">
              <span class="brand-title">PUNJAB GRAINWATCH</span>
              <span class="brand-subtitle">Agricultural Evidence Engine</span>
            </div>
          </a>
        </div>

        <nav class="nav-links" role="navigation" aria-label="Main Navigation">
          <a href="/" class={activeNav === 'overview' ? 'nav-item active' : 'nav-item'}>
            Overview
          </a>
          <a href="/datasets" class={activeNav === 'datasets' ? 'nav-item active' : 'nav-item'}>
            Explorer
          </a>
          <a href="/production-yield" class={activeNav === 'production' ? 'nav-item active' : 'nav-item'}>
            Production & Yield
          </a>
          <a href="/market-watch" class={activeNav === 'markets' ? 'nav-item active' : 'nav-item'}>
            Market Watch
          </a>
          <a href="/weather" class={activeNav === 'weather' ? 'nav-item active' : 'nav-item'}>
            Weather
          </a>
          <a href="/procurement-stocks" class={activeNav === 'procurement' ? 'nav-item active' : 'nav-item'}>
            Procurement & Stocks
          </a>
          <a href="/district-map" class={activeNav === 'map' ? 'nav-item active' : 'nav-item'}>
            District Map
          </a>
          <a href="/status" class={activeNav === 'status' ? 'nav-item active' : 'nav-item'}>
            Audit & Readiness
          </a>
          <a href="/methodology" class={activeNav === 'methodology' ? 'nav-item active' : 'nav-item'}>
            Methodology
          </a>
        </nav>

        <div class="header-actions">
          <div class="evidence-gate-pill" title="Verification gate status">
            <span class="gate-dot"></span>
            <span>GATE: PASSED</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content Area -->
    <main id="main-content" class="main-content" role="main">
      <div class="content-container">
        <slot />
      </div>
    </main>

    <!-- App Footer -->
    <footer class="app-footer" role="contentinfo">
      <div class="footer-container">
        <div class="footer-left">
          <span class="footer-brand">Punjab GrainWatch v0.3.0</span>
          <span class="footer-divider">•</span>
          <span>Phase 4 Usable Dashboard</span>
          <span class="footer-divider">•</span>
          <span>Zero Simulated Hoarding Claims</span>
        </div>
        <div class="footer-right">
          <span>Standard: AGENTS.md Protocol</span>
          <span class="footer-divider">•</span>
          <a href="http://127.0.0.1:8000/docs" target="_blank" rel="noopener noreferrer">FastAPI Swagger</a>
        </div>
      </div>
    </footer>
  </div>
</body>
</html>

<style>
  .app-layout {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background-color: var(--bg-canvas);
    color: var(--text-primary);
    font-family: var(--font-sans);
  }

  .skip-link {
    position: absolute;
    top: -40px;
    left: 10px;
    background: var(--color-wheat-500);
    color: var(--color-slate-950);
    padding: var(--space-2) var(--space-4);
    z-index: 1000;
    font-weight: 600;
    border-radius: var(--radius-sm);
    transition: top var(--transition-fast);
  }
  .skip-link:focus {
    top: 10px;
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .top-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: rgba(15, 20, 28, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-subtle);
  }

  .nav-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: var(--space-3) var(--space-6);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: inherit;
    transition: opacity var(--transition-fast);
  }
  .brand-logo:hover {
    opacity: 0.9;
  }
  .brand-logo:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--radius-sm);
  }

  .logo-icon {
    font-size: 1.5rem;
    line-height: 1;
    filter: drop-shadow(0 2px 4px rgba(232, 200, 114, 0.3));
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-title {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-accent);
  }

  .brand-subtitle {
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-weight: 500;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    overflow-x: auto;
    white-space: nowrap;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 2px 0;
  }
  .nav-links::-webkit-scrollbar {
    display: none;
  }

  .nav-item {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-secondary);
    text-decoration: none;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
  }
  .nav-item:hover {
    color: var(--text-primary);
    background-color: var(--bg-surface-hover);
  }
  .nav-item.active {
    color: var(--color-wheat-500);
    background-color: rgba(232, 200, 114, 0.1);
    font-weight: 700;
  }
  .nav-item:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .evidence-gate-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: 9999px;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-emerald-400);
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
  }

  .gate-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-emerald-400);
    box-shadow: 0 0 6px rgba(16, 185, 129, 0.8);
    animation: pulse 2.5s infinite ease-in-out;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .main-content {
    flex: 1;
    padding: var(--space-8) var(--space-6);
  }

  .content-container {
    max-width: 1440px;
    margin: 0 auto;
  }

  .app-footer {
    background-color: var(--bg-surface);
    border-top: 1px solid var(--border-subtle);
    padding: var(--space-4) var(--space-6);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .footer-container {
    max-width: 1440px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .footer-left, .footer-right {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .footer-brand {
    color: var(--text-secondary);
    font-weight: 600;
  }

  .footer-divider {
    color: var(--border-medium);
  }

  .footer-right a {
    color: var(--text-accent);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .footer-right a:hover {
    text-decoration: underline;
  }
  .footer-right a:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--radius-sm);
  }

  @media (max-width: 900px) {
    .nav-container {
      flex-direction: column;
      align-items: flex-start;
      padding: var(--space-3) var(--space-4);
    }
    .header-actions {
      align-self: flex-end;
      margin-top: -36px;
    }
    .nav-links {
      width: 100%;
      padding-top: var(--space-2);
    }
    .main-content {
      padding: var(--space-6) var(--space-4);
    }
  }
</style>
